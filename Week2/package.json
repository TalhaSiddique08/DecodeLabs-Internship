  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.4.1"
  }
}
