{
  "name": "decodelabs-project-2-crud",
  "version": "1.0.0",
  "description": "DecodeLabs Project 2: Database Integration (CRUD) using Express.js, Prisma, and Supabase PostgreSQL",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node --test test/controller.test.js",
    "test:all": "node --test test/controller.test.js test/validation.test.js",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
