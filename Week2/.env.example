# Application Port
PORT=3000

# PostgreSQL / Supabase Database Connection String
# -----------------------------------------------------------------------------------------
# IMPORTANT: Supabase direct connection (`db.<project-ref>.supabase.co:5432`) is IPv6-ONLY.
# If your network/ISP is IPv4-only, connecting to `db...` will fail with:
# "Can't reach database server at db.pksqlhfhhhvuwjrbosjp.supabase.co:5432"
#
# SOLUTION: Use the Supabase Connection Pooler (which supports IPv4):
# 1. Open: https://supabase.com/dashboard/project/pksqlhfhhhvuwjrbosjp/settings/database
# 2. Scroll to "Connection Pooling" or "Connection string"
# 3. Select Mode: "Session" (Port 5432) or "Transaction" (Port 6543)
# 4. Copy the URI and paste below.
# -----------------------------------------------------------------------------------------

# Recommended: Session Mode (Port 5432 - works for both app queries and prisma db push):
# Format: postgresql://postgres.pksqlhfhhhvuwjrbosjp:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres.pksqlhfhhhvuwjrbosjp:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Alternative: Transaction Mode (Port 6543 - for high-concurrency app queries):
# DATABASE_URL="postgresql://postgres.pksqlhfhhhvuwjrbosjp:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
